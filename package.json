{
  "name": "ayusman-mern-portfolio",
  "version": "2.0.0",
  "description": "Full Stack MERN (MongoDB, Express, React, Node.js) Portfolio for Ayusman Samantaray",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --prefix backend",
    "dev:client": "npm run dev --prefix frontend",
    "start": "node backend/server.js",
    "build": "npm run build --prefix frontend",
    "install:backend": "npm install --prefix backend",
    "install:frontend": "npm install --prefix frontend",
    "install:all": "npm install && npm run install:backend && npm run install:frontend",
    "seed": "npm run seed --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "mern",
    "portfolio",
    "react",
    "nodejs",
    "express",
    "mongodb",
    "vite",
    "full-stack"
  ],
  "author": "Ayusman Samantaray",
  "license": "MIT"
}
